# Local server config. Copy to .env and fill in.

# PostgreSQL (the one you manage in pgAdmin). The database is created automatically if missing.
# Windows: postgres://postgres:YOUR_PASSWORD@localhost:5432/sa_copilot
# macOS (Homebrew): postgres://YOUR_MAC_USERNAME@localhost:5432/sa_copilot
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/sa_copilot

# AI through 9router. Keep `npx 9router` running, open its dashboard (http://localhost:20128),
# connect a provider, create an API key and paste it here. (ANTHROPIC_API_KEY is still read as a fallback.)
9ROUTER_API_KEY=sk-...
ANTHROPIC_BASE_URL=http://localhost:20128
# Default model; you can switch models in the app (model picker).
ANTHROPIC_MODEL=
CHAT_EFFORT=medium
GENERATE_EFFORT=high

# Optional
## Cloud backup/sync: use the same Supabase project; v2.0 scopes backups by account ID.
## Run db/supabase-sync.sql in Supabase SQL editor first. This is NOT the demo REST key.
# CLOUD_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres
# CLOUD_WORKSPACE=default # Legacy v1 only; ignored by v2 account backups.
PORT=3000
# UPLOAD_DIR=data/uploads
# Where generated deliverables are saved as .docx/.xlsx/.md, one folder per project
# DOCS_DIR=data/projects
# Python with markitdown installed (pip install "markitdown[all]"); uploads are converted to Markdown
# Default: python on Windows, python3 on macOS. Set it when markitdown lives in another Python (e.g. a venv).
# MARKITDOWN_PYTHON=python
# Healthcare demo app (scenarios are pushed to its Supabase). DEMO_SUPABASE_URL is the REST base,
# e.g. https://<ref>.supabase.co/rest/v1 ; the key needs insert/delete on `scenarios` and `categories`.
# DEMO_APP_URL=https://healthcare-demo-cekat.vercel.app/
# DEMO_SUPABASE_URL=
# DEMO_SUPABASE_KEY=
# Pitch deck template (slides 31–40 are generated; needs python-pptx: pip install python-pptx)
# DECK_TEMPLATE=C:/SA Copilot/Templates/Deck Cekat.ai Healthcare 2026.pptx
# Outline wiki as a read-only MCP knowledge source (runs `npx outline-mcp-server`; needs Node/npx).
# Create the key in Outline → Settings → API. Leave empty to disable.
# OUTLINE_API_URL=https://wiki.cekat.ai/api
# OUTLINE_API_KEY=
# "Send to Notion" (one page per project): Notion → Settings → Connections → Develop or manage integrations →
# new Internal integration → copy its secret. Then open the parent page → ⋯ → Connections → add the integration.
# NOTION_TOKEN=
# NOTION_PARENT_PAGE=https://www.notion.so/<workspace>/<Page>-<32 hex id>

# Optional legacy Claude Office service (not required by Home).
# CLAUDE_OFFICE_URL=http://localhost:8000
# For a separate frontend/backend, set the backend base URL here:
# CLAUDE_OFFICE_API_URL=http://localhost:8000
